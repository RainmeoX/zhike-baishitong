# ============================================================
# 珠科百事通 环境变量模板
# 用法：cp .env.example .env，然后填入真实密钥
# ============================================================

# GitCode 爬虫 token（爬教务处/后勤处/招生网用）
GITCODE_TOKEN=<your-gitcode-token>

# ---- embedding + rerank：主路 硅基流动 SiliconFlow ----
# 国内免费，注册 https://siliconflow.cn 送额度
# 模型与华为云 MaaS 同款 bge-m3 / bge-reranker-v2-m3
HWMAAS_API_KEY=<your-siliconflow-api-key>
HWMAAS_EMBED_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
HWMAAS_EMBED_MODEL=BAAI/bge-m3
HWMAAS_RERANK_ENDPOINT=https://api.siliconflow.cn/v1/rerank
HWMAAS_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- embedding + rerank：备路 Jina AI（海外，主路失败时自动 fallback）----
# 注册 https://jina.ai 送 1000 万免费 token
# 海外服务，国内需走本地代理（见 JINA_PROXY）
JINA_API_KEY=<your-jina-api-key>
JINA_EMBED_ENDPOINT=https://api.jina.ai/v1/embeddings
JINA_EMBED_MODEL=jina-embeddings-v3
JINA_RERANK_ENDPOINT=https://api.jina.ai/v1/rerank
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
# 本地代理地址（Clash/V2Ray 等），海外请求走此代理；国内直连不需要则留空
JINA_PROXY=http://127.0.0.1:7897

# ---- LLM：智谱 GLM-4-Flash（独立 key，不受 embedding/rerank 切换影响）----
# 注册 https://open.bigmodel.cn
LLM_API_KEY=<your-zhipu-api-key>
LLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
LLM_MODEL=glm-4-flash
