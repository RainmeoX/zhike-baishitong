/* pages/index/index.wxss */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  border: 2rpx solid #e8e8e8;
}
.search-box:focus-within {
  border-color: #409eff;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  margin: 0 12rpx;
}
.search-btn {
  margin-left: 16rpx;
  padding: 12rpx 28rpx;
  background: #409eff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  white-space: nowrap;
}
.section {
  margin-bottom: 32rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.clear-link {
  color: #999;
  font-size: 24rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag-item {
  background: #fff;
  padding: 14rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #555;
  border: 2rpx solid #e8e8e8;
}
.tag-item:active {
  background: #f0f5ff;
  border-color: #409eff;
  color: #409eff;
}