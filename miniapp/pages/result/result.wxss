/* pages/result/result.wxss */
.question-card {
  background: #e8f3ff;
  border: 2rpx solid #b3d8ff;
}
.question-label {
  font-size: 24rpx;
  color: #409eff;
  margin-bottom: 8rpx;
}
.question-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.loading {
  text-align: center;
  padding: 80rpx 0;
}
.loading-spinner {
  display: inline-block;
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e8e8e8;
  border-top-color: #409eff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  margin-top: 20rpx;
  color: #999;
  font-size: 28rpx;
}

.error-card {
  text-align: center;
  padding: 60rpx 24rpx;
}
.error-text {
  margin-top: 16rpx;
  color: #faad14;
  font-size: 28rpx;
}

.answer-card {
  padding-bottom: 24rpx;
}
.answer-label {
  margin-bottom: 16rpx;
}
.confidence-bar {
  height: 8rpx;
  background: #e8e8e8;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}
.confidence-fill {
  height: 100%;
  background: linear-gradient(90deg, #52c41a, #52c41a);
  border-radius: 4rpx;
  transition: width 0.6s ease;
}
.confidence-text {
  font-size: 22rpx;
  color: #999;
  text-align: right;
}
.answer-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
  white-space: pre-wrap;
}

.refs-card {
  padding: 0;
  overflow: hidden;
}
.refs-title {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-bottom: 2rpx solid #f0f0f0;
}
.refs-title text {
  margin-left: 8rpx;
}
.refs-list {
  max-height: 500rpx;
  overflow-y: auto;
}
.ref-item {
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}
.ref-item:active {
  background: #f0f5ff;
}
.ref-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  line-height: 1.5;
}
.ref-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.ref-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background: #f0f5ff;
  color: #409eff;
  border-radius: 8rpx;
}
.ref-score {
  font-size: 22rpx;
  color: #999;
  margin-left: auto;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  background: #fff;
  border-top: 2rpx solid #f0f0f0;
}
.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx;
  background: #f0f5ff;
  border-radius: 16rpx;
  color: #409eff;
  font-size: 28rpx;
}